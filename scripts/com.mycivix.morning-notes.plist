<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: cp scripts/com.mycivix.morning-notes.plist ~/Library/LaunchAgents/ &&
     launchctl load ~/Library/LaunchAgents/com.mycivix.morning-notes.plist
     8:30am local; if the Mac is asleep then, it runs when it wakes. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mycivix.morning-notes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>~/CiViX/scripts/morning-notes.sh</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/michaelyorgensen/Library/Logs/civix/morning-notes.log</string>
  <key>StandardErrorPath</key><string>/Users/michaelyorgensen/Library/Logs/civix/morning-notes.log</string>
</dict>
</plist>
