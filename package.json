{
  "name": "mycivix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:www": "bash scripts/build-www.sh",
    "cap:sync": "npm run build:www && npx cap sync",
    "phone-check": "node scripts/phone-check.js",
    "test": "node --test 'tests/unit/*.test.js'",
    "test:live": "node --test 'tests/live/*.test.js'",
    "test:layout": "node scripts/phone-check.js",
    "test:all": "npm test && npm run test:layout && npm run test:live",
    "ios:testflight": "bash scripts/ios-testflight.sh",
    "ios:live": "bash scripts/ios-live.sh"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^7.0.0"
  }
}
